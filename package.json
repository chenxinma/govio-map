{
  "name": "govio-map",
  "version": "0.7.0",
  "type": "module",
  "bin": {
    "govio-map": "dist-server/cli.mjs"
  },
  "files": [
    "dist",
    "dist-server",
    ".agents",
    "!.agents/skills/govio/assets",
    ".pi"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run compile:server",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "node dist-server/cli.mjs",
    "prepublishOnly": "npm run build",
    "ask": "tsx server/cli.ts",
    "verify": "npm run verify:manifest && npm run verify:rerun && npm run verify:audit && npm run verify:export && npm run verify:source-table && npm run verify:semantic-lineage && npm run verify:caliber-conflict && npm run verify:cwd && npm run verify:prompt-injection && npm run verify:integration && npm run verify:ui",
    "verify:manifest": "tsx scripts/verify-manifest-roundtrip.ts",
    "verify:rerun": "tsx scripts/verify-rerun-drift.ts",
    "verify:audit": "tsx scripts/verify-permission-audit.ts",
    "verify:export": "tsx scripts/verify-export-report.ts",
    "verify:source-table": "tsx scripts/verify-source-table.ts",
    "verify:semantic-lineage": "tsx scripts/verify-semantic-lineage.ts",
    "verify:caliber-conflict": "tsx scripts/verify-caliber-conflict.ts",
    "verify:cwd": "tsx scripts/verify-cwd-normalize.ts",
    "verify:prompt-injection": "tsx scripts/verify-prompt-injection.ts",
    "verify:integration": "vitest run",
    "verify:ui": "vitest run tests/ui",
    "test:integration": "vitest run",
    "compile:server": "esbuild server/serve.ts --bundle --packages=external --platform=node --format=esm --outfile=dist-server/cli.mjs --banner:js=\"#!/usr/bin/env node\""
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "dotenv": "^18.0.5",
    "hyparquet": "^1.31.2",
    "lucide-react": "^1.52.0",
    "node-sql-parser": "^5.4.0",
    "pi-subagents": "^0.81.0",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0",
    "typebox": "^1.3.36",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "typescript": "~6.0.3"
  }
}
