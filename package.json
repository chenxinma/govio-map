{
  "name": "govio-map",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "ask": "tsx server/cli.ts",
    "compile:electron": "esbuild electron/main.ts --bundle --packages=external --platform=node --format=esm --outfile=dist-electron/main.js",
    "build:electron": "tsc -b && vite build && npm run compile:electron && electron-builder"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@xyflow/react": "^12.10.2",
    "chart.js": "^4.5.1",
    "dagre": "^0.8.5",
    "hyparquet": "^1.25.6",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.7",
    "ws": "^8.20.0",
    "zustand": "^5.0.12",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.7"
  },
  "build": {
    "appId": "com.govio.map",
    "productName": "Govio Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.wasm",
      "node_modules/@silvia-odwyer/photon-node/**/*",
      "node_modules/@mariozechner/clipboard/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
