{
  "name": "govio-map",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "ask": "tsx server/cli.ts",
    "compile:electron": "esbuild electron/main.ts --bundle --packages=external --platform=node --format=esm --outfile=dist-electron/main.js",
    "build:electron": "tsc -b && vite build && npm run compile:electron && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "dagre": "^0.8.5",
    "dotenv": "^18.0.5",
    "hyparquet": "^1.31.2",
    "lucide-react": "^1.52.0",
    "pi-subagents": "^0.76.1",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0",
    "typebox": "^1.3.36",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  },
  "overrides": {
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.govio.map",
    "productName": "Govio Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.wasm",
      "node_modules/@silvia-odwyer/photon-node/**/*",
      "node_modules/@mariozechner/clipboard/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
